[Unit]
Description=Quod Stage 1/2 Lean Kernel Verification Daemon
After=network-online.target quod-hub.service docker.service
Wants=quod-hub.service

[Service]
Type=simple
User=quod
Group=quod
EnvironmentFile=-/etc/quod/quod-verifier.env
ExecStart=/opt/quod/bin/quod-verifier --runner bwrap --concurrency 4
Restart=on-failure
RestartSec=3s
LimitNOFILE=65536
TasksMax=512
MemoryMax=12G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/quod

[Install]
WantedBy=multi-user.target
