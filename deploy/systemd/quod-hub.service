[Unit]
Description=Quod Event-Sourced Lean 4 Collaboration Coordinator
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=quod
Group=quod
EnvironmentFile=-/etc/quod/quod-hub.env
ExecStart=/opt/quod/bin/quod-hub --listen 0.0.0.0:8080
Restart=on-failure
RestartSec=3s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/quod

[Install]
WantedBy=multi-user.target
